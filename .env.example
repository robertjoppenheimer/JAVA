# Autocratic Environment Configuration
# Copy this file to .env.local for local overrides.
# In Vercel, configure these under: Project Settings -> Environment Variables.

# External webhook integration (Slack, Discord, Zapier, Make, or custom CRM endpoint)
# CRITICAL FOR VERCEL DEPLOYMENTS:
# In Vercel serverless, local file persistence writes to ephemeral /tmp storage, which does NOT
# survive Lambda cold starts, multi-region container instances, or redeployments.
# Setting CONTACT_WEBHOOK_URL ensures durable, immediate delivery of all submitted enquiries.
# Example: https://hooks.slack.com/services/YOUR_WORKSPACE_ID/YOUR_CHANNEL_ID/YOUR_TOKEN
CONTACT_WEBHOOK_URL=

# Optional custom directory path for local append-only JSONL persistent enquiry storage.
# Defaults to .data/enquiries.jsonl locally, and /tmp/autocratic-enquiries.jsonl on Vercel.
STORAGE_FILE_PATH=
