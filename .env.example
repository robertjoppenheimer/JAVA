# Autocratic Environment Configuration
# Copy this file to .env.local for local overrides.
# In Vercel, set these in the Project Settings -> Environment Variables.

# Optional external webhook integration (Slack, Discord, Zapier, Make, or custom CRM endpoint)
# When set, valid consultation requests are immediately posted to this URL.
# Example: https://hooks.slack.com/services/YOUR_WORKSPACE_ID/YOUR_CHANNEL_ID/YOUR_TOKEN
CONTACT_WEBHOOK_URL=

# Optional custom directory path for local append-only JSONL persistent enquiry storage.
# Defaults to .data/enquiries.jsonl locally, and /tmp/autocratic-enquiries.jsonl in Vercel.
STORAGE_FILE_PATH=
